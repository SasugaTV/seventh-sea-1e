<form class="{{cssClass}} flexcol ss1e-item-sheet" autocomplete="off">
    <header class="sheet-header">
        <img class="profile-img" src="{{item.img}}" data-edit="img" />
        <div class="header-fields">
            <h1><input name="name" type="text" value="{{item.name}}" /></h1>
            <div class="header-row">
                <label>{{localize "SS1E.UI.Quantity"}}</label>
                <input type="number" name="system.quantity" value="{{system.quantity}}" min="0" />
                <label>{{localize "SS1E.UI.Weight"}}</label>
                <input type="number" name="system.weight" value="{{system.weight}}" min="0" step="0.1" />
                <label>{{localize "SS1E.UI.Price"}}</label>
                <input type="number" name="system.price.value" value="{{system.price.value}}" min="0" />
                <input type="text" name="system.price.currency" value="{{system.price.currency}}" />
            </div>
        </div>
    </header>
    <section class="sheet-body">
        <h3>{{localize "SS1E.UI.Description"}}</h3>
        {{editor enriched.description target="system.description" button=true editable=editable}}
    </section>
</form>
