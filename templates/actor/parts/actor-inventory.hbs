<section class="tab inventory" data-group="primary" data-tab="inventory">
    <header class="section-header">
        <h2>{{localize "SS1E.UI.Inventory"}}</h2>
        <button class="item-create" data-type="weapon">+ {{localize "SS1E.ItemType.Weapon"}}</button>
        <button class="item-create" data-type="armor">+ {{localize "SS1E.ItemType.Armor"}}</button>
        <button class="item-create" data-type="gear">+ {{localize "SS1E.ItemType.Gear"}}</button>
    </header>

    <h3>{{localize "SS1E.UI.Weapons"}}</h3>
    <ol class="items-list">
        {{#each weapons as |w|}}
        <li data-item-id="{{w._id}}">
            <strong>{{w.name}}</strong>
            <span>{{localize (lookup ../config.weaponTypes w.system.weaponType)}}</span>
            <span>{{w.system.damageFormula}}</span>
            <a class="item-edit"><i class="fas fa-edit"></i></a>
            <a class="item-delete"><i class="fas fa-trash"></i></a>
        </li>
        {{/each}}
    </ol>

    <h3>{{localize "SS1E.UI.Armor"}}</h3>
    <ol class="items-list">
        {{#each armor as |a|}}
        <li data-item-id="{{a._id}}">
            <strong>{{a.name}}</strong>
            <span>Soak {{a.system.soak}}</span>
            <a class="item-edit"><i class="fas fa-edit"></i></a>
            <a class="item-delete"><i class="fas fa-trash"></i></a>
        </li>
        {{/each}}
    </ol>

    <h3>{{localize "SS1E.UI.Gear"}}</h3>
    <ol class="items-list">
        {{#each gear as |g|}}
        <li data-item-id="{{g._id}}">
            <strong>{{g.name}}</strong>
            <span>×{{g.system.quantity}}</span>
            <a class="item-edit"><i class="fas fa-edit"></i></a>
            <a class="item-delete"><i class="fas fa-trash"></i></a>
        </li>
        {{/each}}
    </ol>
</section>
